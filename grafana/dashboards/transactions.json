    {
      "id": 2,
      "type": "bargauge",
      "title": "Dropped lines (last 7 days)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Lines that were not stored, by reason: rejected by the Alloy pipeline (malformed_or_missing_field, invalid_date, invalid_account, invalid_type) or by Loki (too_far_in_future). Independent of the dashboard time range.",
      "gridPos": {
        "h": 20,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "timeFrom": "7d",
      "hideTimeOverride": false,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "{{reason}}",
          "expr": "clamp_min(sum by (reason) (loki_process_dropped_lines_total{component_id=\"loki.process.transactions\"} - loki_process_dropped_lines_total{component_id=\"loki.process.transactions\"} offset $__range), 0) or sum by (reason) (loki_process_dropped_lines_total{component_id=\"loki.process.transactions\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "{{reason}} (Loki)",
          "expr": "clamp_min(sum by (reason) (loki_discarded_samples_total{tenant=\"fake\"} - loki_discarded_samples_total{tenant=\"fake\"} offset $__range), 0) or sum by (reason) (loki_discarded_samples_total{tenant=\"fake\"})"
        }
      ]
    }
