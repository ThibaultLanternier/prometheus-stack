# Copy to .env and adjust. Every value below is the default used when unset.

# Prometheus
PROMETHEUS_PORT=9090
# How long Prometheus keeps samples. Keep it long so backfilled history is not deleted.
PROMETHEUS_RETENTION=10y
# PromQL lookback window. Raise it (e.g. 1h) when your data is sampled less often than every 5 minutes.
PROMETHEUS_LOOKBACK_DELTA=5m

# Grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Folder holding the OpenMetrics files to import (with processed/ and failed/ subfolders)
IMPORT_DIR=./import

# Loki (transaction storage)
LOKI_PORT=3100
# How long Loki keeps transactions.
LOKI_RETENTION=10y

# Alloy (transaction ingestion)
ALLOY_PORT=12345
# Folder Alloy watches for .jsonl transaction files
IMPORT_TRANSACTIONS_DIR=./import-transactions
